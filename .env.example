# ========== 美国服务器 + 域名（推荐） ==========
# 把 example.com 换成你的域名。
# 先做好 DNS，再启动，Caddy 才会自动签 Let's Encrypt 证书。

# 主站 / Docker Hub 加速入口
SITE_ADDRESS=mirror.example.com

# 用来拼子域名：ghcr.example.com、k8s.example.com ...
# 一般填主域名，不要带 mirror.
DOMAIN=example.com

# Let's Encrypt 通知邮箱
ACME_EMAIL=admin@example.com

# 有域名就保持 false，走 HTTPS
HTTP_ONLY=false

# Docker Hub 账号（强烈建议填，匿名很容易 429）
# 用 Access Token，不要用登录密码
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=

# 美国机器一般直连官方仓库即可，不用代理
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,caddy,registry-dockerhub,registry-ghcr,registry-gcr,registry-quay,registry-k8s,registry-nvcr,registry-mcr

# 这台机器 80/443 往往已被 3x-ui / 其他 Caddy 占用。
# 默认只绑本机 5080，再由现有反代把 docker.你的域名 转过来。
# 如果这台机器 80/443 空着，改成：
#   HTTP_BIND=0.0.0.0
#   HTTP_PORT=80
#   HTTPS_BIND=0.0.0.0
#   HTTPS_PORT=443
HTTP_BIND=127.0.0.1
HTTP_PORT=5080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=5443
