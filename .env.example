# ========== 美国服务器 + 域名（推荐） ==========
# 把 example.com 换成你的域名。
# 先做好 DNS。脚本会按 80/443 是否被占用自动选边缘。

# 主站 / Docker Hub 加速入口
SITE_ADDRESS=mirror.example.com

# 用来拼子域名：ghcr.example.com、k8s.example.com ...
# 一般填主域名，不要带 mirror.
DOMAIN=example.com

# Let's Encrypt 通知邮箱
ACME_EMAIL=admin@example.com

# 内部路由器永远是 HTTP。这一项由 adapt-host 维护，不要手改成对外 HTTPS。
HTTP_ONLY=true

# Docker Hub 账号（强烈建议填，匿名很容易 429）
# 用 Access Token，不要用登录密码
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=

# 美国机器一般直连官方仓库即可，不用代理
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,caddy,edge,registry-dockerhub,registry-ghcr,registry-gcr,registry-quay,registry-k8s,registry-nvcr,registry-mcr

# 内部缓存只绑本机 5080。80/443 空闲时会额外启动 edge 容器对外签证书。
# 80/443 已被 Nginx/Caddy 占用时，adapt-host 会写进现有反代。
HTTP_BIND=127.0.0.1
HTTP_PORT=5080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=5443

# 由 adapt-host 自动写：direct 时空，behind-* 时清空
COMPOSE_PROFILES=
EDGE_MODE=
