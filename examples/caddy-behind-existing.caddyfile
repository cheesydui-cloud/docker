# 贴到「已经占用 80/443 的那套 Caddy」里。
# 证书仍由现有 Caddy 签，镜像站只听 127.0.0.1:5080。
# 不要再让内部 Caddy 签同一张证书。

YOUR_MIRROR_HOST {
	reverse_proxy 127.0.0.1:5080 {
		flush_interval -1
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
